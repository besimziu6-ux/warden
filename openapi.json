    "/ws/servers/{id}/console": {
      "get": {
        "tags": [
          "console"
        ],
        "description": "WebSocket console. Auth via `?token=<jwt>` or `Authorization: Bearer <token>` on the upgrade request. Client sends a command line as plain text or `{\"command\": \"...\"}`; server streams console lines back. History is replayed on connect and persisted to `data/servers/<id>/console.log`. Mock ticks are emitted when no Docker container is attached.",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "token",
            "schema": {
              "type": "string"
            },
            "description": "JWT (alternative to the Authorization header)."
          }
        ],
        "responses": {
          "101": {
            "description": "Switching protocols: console stream"
          },
          "401": {
            "description": "Missing/invalid token"
          },
          "403": {
            "description": "Not the owner (non-admin)"
          },
          "404": {
            "description": "Unknown server"
          }
        },
        "x-websocket": true
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Egg": {
        "type": "object",
        "required": [
          "id",
          "name",
          "image",
          "startup"
        ],
        "properties": {
          "id": {
            "type": "string",
            "example": "minecraft-java"
          },
          "name": {
            "type": "string"
          },
          "image": {
            "type": "string",
            "example": "itzg/minecraft-server:latest"
          },
          "startup": {
            "type": "string"
          },
          "env": {
            "type": "object"
          },
          "ports": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EggPort"
            }
          }
        }
      },
      "EggPort": {
        "type": "object",
        "required": [
          "container"
        ],
        "properties": {
          "container": {
            "type": "integer",
            "example": 25565
          },
          "protocol": {
            "type": "string",
            "enum": [
              "tcp",
              "udp"
            ]
          }
        }
      },
      "Server": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "game": {
            "type": "string",
            "example": "minecraft-java"
          },
          "env": {
            "type": "object"
          },
          "image": {
            "type": "string"
          },
          "ports": {
            "type": "array"
          },
          "status": {
            "type": "string",
            "enum": [
              "created",
              "running",
              "stopped",
              "killed",
              "paused",
              "error"
            ]
          },
          "containerId": {
            "type": "string",
            "nullable": true
          },
          "ownerId": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "username": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "admin",
              "user"
            ]
          },
          "createdAt": {
            "type": "string"
          }
        }
      },
      "Schedule": {
        "type": "object",
        "required": [
          "cron",
          "action"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "cron": {
            "type": "string",
            "example": "0 4 * * *"
          },
          "action": {
            "type": "string",
            "enum": [
              "start",
              "stop",
              "restart",
              "backup",
              "command"
            ]
          },
          "payload": {
            "type": "object",
            "nullable": true
          },
          "enabled": {
            "type": "boolean"
          }
        }
      },
      "FileEntry": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "dir",
              "file"
            ]
          },
          "size": {
            "type": "integer",
            "nullable": true
          },
          "mtime": {
            "type": "string"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      }
    }
  }
}
