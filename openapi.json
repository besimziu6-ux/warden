{
  "openapi": "3.0.3",
  "info": {
    "title": "game-panel API",
    "version": "0.1.0",
    "description": "Self-hosted game server panel. Bearer JWT from /api/auth/* goes in `Authorization: Bearer <token>`. The live console is a WebSocket (see /ws/servers/{id}/console)."
  },
  "servers": [
    {
      "url": "http://localhost:3000"
    }
  ],
  "tags": [
    {
      "name": "auth"
    },
    {
      "name": "servers"
    },
    {
      "name": "files"
    },
    {
      "name": "players"
    },
    {
      "name": "backups"
    },
    {
      "name": "schedules"
    },
    {
      "name": "console"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "servers"
        ],
        "responses": {
          "200": {
            "description": "Liveness plus mock flag"
          }
        }
      }
    },
    "/api/games": {
      "get": {
        "tags": [
          "servers"
        ],
        "responses": {
          "200": {
            "description": "The 7 pinned eggs"
          }
        }
      }
    },
    "/api/auth/register": {
      "post": {
        "tags": [
          "auth"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "username",
                  "password"
                ],
                "properties": {
                  "username": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9_-]{3,32}$"
                  },
                  "password": {
                    "type": "string",
                    "minLength": 6
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Registered; first user becomes admin"
          },
          "400": {
            "description": "Validation error"
          },
          "409": {
            "description": "Username taken"
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "username",
                  "password"
                ],
                "properties": {
                  "username": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Logged in"
          },
          "401": {
            "description": "Bad credentials"
          }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "tags": [
          "auth"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Current user"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/users": {
      "get": {
        "tags": [
          "auth"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "User list (admin only)"
          },
          "403": {
            "description": "Forbidden"
          }
        }
      }
    },
    "/api/servers": {
      "get": {
        "tags": [
          "servers"
        ],
        "responses": {
          "200": {
            "description": "Server list"
          }
        }
      },
      "post": {
        "tags": [
          "servers"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "game",
                  "name"
                ],
                "properties": {
                  "game": {
                    "type": "string",
                    "example": "minecraft-java"
                  },
                  "name": {
                    "type": "string"
                  },
                  "env": {
                    "type": "object"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created"
          },
          "400": {
            "description": "Unknown game or missing fields"
          }
        }
      }
    },
    "/api/servers/{id}": {
      "get": {
        "tags": [
          "servers"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "One server"
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    },
    "/api/servers/{id}/{action}": {
      "post": {
        "tags": [
          "servers"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "action",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "start",
                "stop",
                "restart",
                "kill"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Updated server with status"
          },
          "404": {
            "description": "Not found"
          },
          "500": {
            "description": "Driver error"
          }
        }
      }
    },
    "/api/servers/{id}/files": {
      "get": {
        "tags": [
          "files"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Entry or directory listing"
          },
          "400": {
            "description": "Invalid path"
          }
        }
      },
      "put": {
        "tags": [
          "files"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "path",
                  "content"
                ],
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "content": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Written"
          },
          "400": {
            "description": "Invalid path"
          },
          "413": {
            "description": "Over 20MB"
          }
        }
      }
    },
    "/api/servers/{id}/files/download": {
      "get": {
        "tags": [
          "files"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "File bytes"
          },
          "400": {
