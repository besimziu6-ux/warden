# Copy to .env and fill in: cp .env.example .env
# scripts/install.sh does this automatically and generates JWT_SECRET.

# Port the panel listens on (host + container).
PORT=3000

# Long random string used to sign auth tokens. Required.
# Generate one with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# Token lifetime (jsonwebtoken format).
JWT_EXPIRES=7d

# Set to production to enable strict startup checks (JWT_SECRET required).
# In production the backend exits at boot when JWT_SECRET is missing or weak.
# NODE_ENV=production

# Restrict CORS to your frontend origin(s). Comma-separated for multiple.
# When unset, all origins are allowed (dev only).
# FRONTEND_ORIGIN=https://panel.example.com

# Host path for panel data (servers, users, backups).
# Inside compose the panel sees this as /app/data.
DATA_ROOT=./data

# Default admin for scripts/create-admin.js (env or argv).
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=
