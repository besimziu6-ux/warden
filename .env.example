# Copy to .env and fill in: cp .env.example .env
# scripts/install.sh does this automatically and generates JWT_SECRET.

# Port the panel listens on (host + container).
PORT=3000

# Long random string used to sign auth tokens. Required.
# Generate one with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# Token lifetime (jsonwebtoken format).
JWT_EXPIRES=7d

# Host path for panel data (servers, users, backups).
# Inside compose the panel sees this as /app/data.
DATA_ROOT=./data

# Default admin for scripts/create-admin.js (env or argv).
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=
